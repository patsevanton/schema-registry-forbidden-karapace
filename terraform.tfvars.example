# Скопировать в terraform.tfvars (не коммитится — *.tfvars в .gitignore) и заполнить.
# folder_id — из консоли Yandex Cloud.
# kafka_password — пароль сервисного пользователя Kafka (не админа кластера).
# Используется и Go-приложением (SASL), и для Basic Auth в Schema Registry.
# kafka_ui_password — пароль пользователя Kafka для kafbat-ui.

folder_id         = "b1gxxxxxxxxxxxxxxxx"
kafka_password    = "replace-with-a-strong-password"
kafka_ui_password = "replace-with-a-strong-password"
