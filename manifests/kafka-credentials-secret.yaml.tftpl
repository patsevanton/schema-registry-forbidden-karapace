# Секрет с кредами Kafka/Schema Registry. Рендерится Terraform'ом на диск и
# применяется вручную: kubectl apply -f manifests/kafka-credentials-secret.yaml.
# Пароль не попадает в git (terraform.tfvars в .gitignore) и в Helm values.
apiVersion: v1
kind: Namespace
metadata:
  name: schema-registry-forbidden
---
apiVersion: v1
kind: Secret
metadata:
  name: kafka-credentials
  namespace: schema-registry-forbidden
type: Opaque
stringData:
  KAFKA_BOOTSTRAP: "${kafka_bootstrap}:9091"
  SCHEMA_REGISTRY_URL: "${schema_registry_url}"
  KAFKA_USER: "${kafka_user}"
  KAFKA_PASSWORD: "${kafka_password}"